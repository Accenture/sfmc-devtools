{
  "name": "mcdev",
  "version": "9.0.3",
  "description": "Accenture Salesforce Marketing Cloud DevTools",
  "author": "Accenture: joern.berkefeld, douglas.midgley, robert.zimmermann, maciej.barnas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accenture/sfmc-devtools.git"
  },
  "homepage": "https://github.com/Accenture/sfmc-devtools/wiki",
  "bugs": {
    "url": "https://github.com/Accenture/sfmc-devtools/issues",
    "email": "joern.berkefeld@accenture.com"
  },
  "funding": {
    "type": "corporate",
    "url": "https://github.com/Accenture/sfmc-devtools"
  },
  "keywords": [
    "sfmc",
    "ide",
    "devops",
    "developer",
    "exacttarget",
    "salesforce",
    "marketing cloud",
    "package manager",
    "fuel",
    "soap",
    "rest"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./@types/lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./@types/lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "bin": {
    "mcdev": "lib/cli.js"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "start": "node lib/cli.js",
    "mcdev": "node lib/cli.js",
    "debug": "node --nolazy --inspect-brk=9229 lib/cli.js",
    "lint:fix": "eslint --fix lib/**/*.js types/*.js test/**/*.js",
    "lint": "eslint lib/**/*.js types/*.js test/**/*.js",
    "lint-ts": "tsc -p tsconfig.npmScripts.json",
    "verify:packed": "node scripts/verify-packed-package.mjs",
    "prepare": "husky || true",
    "lint-and-test": "run-s lint test",
    "test": "mocha --reporter-option maxDiffSize=25000",
    "coverage": "c8 npm run test",
    "prepare-release:audit-fix": "npm audit fix",
    "prepare-release:git": "node prepare-release.js",
    "prepare-release": "run-s --continue-on-error prepare-release:audit-fix lint-ts lint:fix prepare-release:git",
    "version:major": "npm version --no-commit-hooks major",
    "version:minor": "npm version --no-commit-hooks minor",
    "version:patch": "npm version --no-commit-hooks patch"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.2",
    "cli-progress": "3.12.0",
    "command-exists": "1.2.9",
    "conf": "15.1.0",
    "console.table": "0.10.0",
    "deep-equal": "2.2.3",
    "fast-xml-parser": "5.11.1",
    "fs-extra": "11.4.1",
    "json-to-table": "4.2.1",
    "mustache": "4.2.0",
    "p-limit": "7.3.3",
    "prettier": "3.9.9",
    "prettier-plugin-sfmc": "2.1.0",
    "semver": "7.8.5",
    "sfmc-sdk": "4.0.0",
    "simple-git": "3.36.0",
    "toposort": "2.0.2",
    "update-notifier": "7.3.1",
    "winston": "3.19.0",
    "yargs": "18.2.0",
    "yocto-spinner": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/fs-extra": "11.0.4",
    "@types/mocha": "10.0.10",
    "@types/mock-fs": "4.13.4",
    "@types/node": "26.6.2",
    "@types/yargs": "17.0.35",
    "assert": "2.1.0",
    "axios-mock-adapter": "2.1.0",
    "c8": "12.0.0",
    "chai": "6.2.2",
    "chai-files": "1.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-sfmc": "5.2.0",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mocha": "12.0.2",
    "mock-fs": "5.5.0",
    "npm-run-all": "4.1.5",
    "prettier-eslint": "17.1.2",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "fsevents": "*"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "type": "module",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  }
}
